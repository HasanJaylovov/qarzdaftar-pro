<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16">

    <!-- OBUNA QULF EKRANI -->
    <LinearLayout
        android:id="@+id/lockScreenLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_qarzdaftar_logo"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QarzFy"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tvLockStoreId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Do'kon ID: QF-101"
            android:textColor="#38BDF8"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Obuna muddati tugagan yoki faol emas.\nDasturni ishga tushirish uchun Telegram bot orqali obunani faollashtiring."
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="28dp"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="💳 Telegram Botda To'lash"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0284C7"
            android:onClick="openTelegramBotForPayment"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🔄 Holatni qayta tekshirish"
            android:textColor="#E2E8F0"
            android:backgroundTint="#1E293B"
            android:onClick="refreshStatusClick"/>
    </LinearLayout>

    <!-- ASOSIY BOSHQARUV PANELI -->
    <LinearLayout
        android:id="@+id/mainContentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_qarzdaftar_logo"
                android:layout_marginEnd="12dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QarzFy"
                    android:textColor="#FFFFFF"
                    android:textSize="19sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvSubBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✅ Obuna faol • Kanalga eksport yoniq"
                    android:textColor="#10B981"
                    android:textSize="12sp"/>
            </LinearLayout>

            <Button
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="⚙️ Sozlama"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#334155"
                android:onClick="openSettingsClick"
                android:layout_marginEnd="6dp"/>

            <Button
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="📊 Excel"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#059669"
                android:onClick="exportToExcelClick"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#1E293B"
                android:padding="12dp"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jami Qarzlar"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tvTotalDebt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 so'm"
                    android:textColor="#38BDF8"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#1E293B"
                android:padding="12dp"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Qarzdorlar soni"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tvDebtorsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 ta mijoz"
                    android:textColor="#F87171"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="➕ Qarz Yozish"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0284C7"
                android:textStyle="bold"
                android:onClick="openAddDebtDialog"
                android:layout_marginEnd="6dp"/>

            <Button
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="📩 Yoppasiga SMS"
                android:textColor="#FFFFFF"
                android:backgroundTint="#D97706"
                android:textStyle="bold"
                android:onClick="sendRemindersToAllClick"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="#1E293B"
            android:hint="🔍 Ism yoki telefon raqam bo'yicha qidiruv..."
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:paddingHorizontal="14dp"
            android:textSize="14sp"
            android:singleLine="true"
            android:layout_marginBottom="10dp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/debtorsListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </ScrollView>

    </LinearLayout>
</FrameLayout>
