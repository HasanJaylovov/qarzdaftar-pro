<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090D16">

    <!-- LOGIN / RO'YXATDAN O'TISH EKRANI -->
    <LinearLayout
        android:id="@+id/loginScreenLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp"
        android:visibility="visible">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:src="@drawable/ic_qarzdaftar_logo"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="QarzFy Tizimiga Kirish"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <EditText
            android:id="@+id/etLoginPhone"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#1E293B"
            android:hint="Telefon raqam (+998901234567)"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:inputType="phone"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etLoginPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#1E293B"
            android:hint="Parol"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:inputType="textPassword"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/etLoginChannel"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#1E293B"
            android:hint="Telegram Kanal Linki (@kanal_nomi)"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="20dp"/>

        <Button
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="🔑 Kirish / Ro'yxatdan o'tish"
            android:textColor="#FFFFFF"
            android:backgroundTint="#0284C7"
            android:textStyle="bold"
            android:onClick="performLoginClick"/>
    </LinearLayout>

    <!-- ASOSIY BOSHQARUV PANELI -->
    <LinearLayout
        android:id="@+id/mainContentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_qarzdaftar_logo"
                android:layout_marginEnd="10dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QarzFy"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvUserStoreBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Do'kon ID: QF-101"
                    android:textColor="#10B981"
                    android:textSize="11sp"/>
            </LinearLayout>

            <Button
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="📤 Kanalga yuborish"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0284C7"
                android:onClick="sendToTelegramChannelClick"
                android:layout_marginEnd="4dp"/>

            <Button
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="ℹ️ Info"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#334155"
                android:onClick="openInfoDialogClick"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#1E293B"
                android:padding="12dp"
                android:orientation="vertical"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jami Qarzlar"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/tvTotalDebt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 so'm"
                    android:textColor="#38BDF8"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#1E293B"
                android:padding="12dp"
                android:orientation="vertical"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Qarzdorlar soni"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"/>

                <TextView
                    android:id="@+id/tvDebtorsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 ta mijoz"
                    android:textColor="#F87171"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="➕ Qarz Yozish"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0284C7"
                android:textStyle="bold"
                android:onClick="openAddDebtDialog"
                android:layout_marginEnd="6dp"/>

            <Button
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:text="📊 Excel Eksport"
                android:textColor="#FFFFFF"
                android:backgroundTint="#059669"
                android:textStyle="bold"
                android:onClick="exportToExcelClick"
                android:layout_marginStart="6dp"/>
        </LinearLayout>

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:background="#1E293B"
            android:hint="🔍 Ism yoki telefon bo'yicha qidiruv..."
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:paddingHorizontal="14dp"
            android:textSize="13sp"
            android:singleLine="true"
            android:layout_marginBottom="8dp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/debtorsListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </ScrollView>

    </LinearLayout>
</FrameLayout>
